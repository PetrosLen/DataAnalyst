APP_ENV=local
DATABASE_URL=postgresql+psycopg2://wheretoto:wheretoto@localhost:5432/wheretoto
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Only needed to run app/ingestion/enrichment/google_places_photos.py — see
# backend README §Photos. Requires a billing-enabled Google Cloud project.
GOOGLE_PLACES_API_KEY=
MEDIA_DIR=media
MEDIA_PUBLIC_BASE_URL=http://localhost:8000/media
# Safety net so the enrichment script can't rack up a surprise bill —
# see backend README §"Monthly call cap".
GOOGLE_PLACES_MONTHLY_CALL_CAP=1000
GOOGLE_PLACES_MONTHLY_CALL_SAFETY_MARGIN=30
